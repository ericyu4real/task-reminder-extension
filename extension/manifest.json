{
  "manifest_version": 3,
  "name": "任务提醒",
  "version": "0.1.0",
  "description": "在网页右上角持续提醒你当前正在做的任务。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["store.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "任务提醒：点击设置当前任务",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
